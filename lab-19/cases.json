[
  {
    "source": "task01_segment.cpp",
    "tests": [
      {
        "name": "sample",
        "input": "12 4 -3\n",
        "expected": "4 12 8\n1 9 8\n"
      },
      {
        "name": "equal endpoints",
        "input": "5 5 0\n",
        "expected": "5 5 0\n5 5 0\n"
      },
      {
        "name": "coordinate limits",
        "input": "1000 -1000 -1000\n",
        "expected": "-1000 1000 2000\n-2000 0 2000\n"
      }
    ]
  },
  {
    "source": "task02_timer.cpp",
    "tests": [
      {
        "name": "sample",
        "input": "0 125 90 95\n",
        "expected": "00:01:00\n02:06:30\n02:04:55\n"
      },
      {
        "name": "expired",
        "input": "0 0 0 10000\n",
        "expected": "00:01:00\n00:00:00\n00:00:00\n"
      },
      {
        "name": "normalization limits",
        "input": "23 180 120 0\n",
        "expected": "00:01:00\n26:02:00\n26:02:00\n"
      }
    ]
  },
  {
    "source": "task03_wallet.cpp",
    "tests": [
      {
        "name": "sample",
        "input": "100 4\n30 90 20 70\n",
        "expected": "OK\nREJECTED\nOK\nREJECTED\n100 50\n"
      },
      {
        "name": "exact balance",
        "input": "10 2\n10 1\n",
        "expected": "OK\nREJECTED\n10 0\n"
      },
      {
        "name": "empty wallet",
        "input": "0 1\n1\n",
        "expected": "REJECTED\n0 0\n"
      }
    ]
  },
  {
    "source": "task04_gradebook.cpp",
    "tests": [
      {
        "name": "sample",
        "input": "4\n60 80 90 70\n1 100\n",
        "expected": "300 75.00\n320 80.00\n"
      },
      {
        "name": "single grade",
        "input": "1\n0\n0 100\n",
        "expected": "0 0.00\n100 100.00\n"
      },
      {
        "name": "full gradebook",
        "input": "10\n100 100 100 100 100 100 100 100 100 100\n9 0\n",
        "expected": "1000 100.00\n900 90.00\n"
      }
    ]
  },
  {
    "source": "task05_parcel.cpp",
    "tests": [
      {
        "name": "sample",
        "input": "20 10 5 1200 15\n",
        "expected": "1000 46\n3000 50\n"
      },
      {
        "name": "rounding up",
        "input": "1 1 1 1001 100\n",
        "expected": "1 46\n100 46\n"
      },
      {
        "name": "maximum dimensions",
        "input": "100 100 100 10000 1\n",
        "expected": "1000000 2100\n10000 120\n"
      }
    ]
  },
  {
    "source": "task06_ticket.cpp",
    "tests": [
      {
        "name": "sample",
        "input": "Cinema Olena Ivan Taras\n",
        "expected": "1 Cinema Olena\n2 Cinema Ivan\n3 Cinema Taras\n"
      },
      {
        "name": "same holder",
        "input": "Event A A A\n",
        "expected": "1 Event A\n2 Event A\n3 Event A\n"
      }
    ]
  },
  {
    "source": "task07_result.cpp",
    "tests": [
      {
        "name": "sample",
        "input": "85 30\n",
        "expected": "COPY 85\nLOCAL 100\nORIGINAL 85\n"
      },
      {
        "name": "zero bonus",
        "input": "0 0\n",
        "expected": "COPY 0\nLOCAL 0\nORIGINAL 0\n"
      },
      {
        "name": "below cap",
        "input": "40 10\n",
        "expected": "COPY 40\nLOCAL 50\nORIGINAL 40\n"
      }
    ]
  },
  {
    "source": "task08_robot.cpp",
    "tests": [
      {
        "name": "sample",
        "input": "Control Drive\n",
        "expected": "START Control\nSTART Drive\nROBOT READY\nWORK\nROBOT OFF\nSTOP Drive\nSTOP Control\nEND\n"
      },
      {
        "name": "same module names",
        "input": "Unit Unit\n",
        "expected": "START Unit\nSTART Unit\nROBOT READY\nWORK\nROBOT OFF\nSTOP Unit\nSTOP Unit\nEND\n"
      }
    ]
  },
  {
    "source": "task09_document.cpp",
    "tests": [
      {
        "name": "sample",
        "input": "Report\n",
        "expected": "0\n1\n2\n3 Report\n2\n1\n0\n"
      },
      {
        "name": "different document name",
        "input": "Notes\n",
        "expected": "0\n1\n2\n3 Notes\n2\n1\n0\n"
      }
    ]
  },
  {
    "source": "task10_record.cpp",
    "tests": [
      {
        "name": "sample",
        "input": "Alpha Beta Gamma\n",
        "expected": "NEW Alpha\nNEW Beta\nNEW empty\nCOPY Alpha\nINNER\nDELETE Gamma\nARRAY\nDELETE empty\nDELETE Beta\nDELETE Alpha\nEND\n"
      },
      {
        "name": "same labels",
        "input": "A A A\n",
        "expected": "NEW A\nNEW A\nNEW empty\nCOPY A\nINNER\nDELETE A\nARRAY\nDELETE empty\nDELETE A\nDELETE A\nEND\n"
      }
    ]
  }
]
